# The versions this repository is built, tested and verified with. scripts/reproduce.sh and
# scripts/reproduce.ps1 read this file; tests/test_docs.py checks that it agrees with .python-version,
# rust-toolchain.toml, the examples' codegen.toml and the tests' Deno imports.
PYTHON=3.13
RUST=1.96.0
MCRL2=202607.0
DENO=2
SVELTE=5.57.2
TYPESCRIPT=5.9.3
# Where scripts/reproduce.sh looks for the mCRL2 tools of that release when PATH does not have them (colon-separated;
# ~ is the home directory and {MCRL2} the release above). The first directory whose mcrl22lps reports the pinned release wins.
MCRL2_DIRS=~/mcrl2-{MCRL2}/bin:/opt/mcrl2-{MCRL2}/bin:/opt/mcrl2/bin:/usr/local/bin:/Applications/mCRL2.app/Contents/bin:~/.local/bin:~/.deno/bin
