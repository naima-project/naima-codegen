% env.mcrl2 -- the environment of the group pool, for the non-blocking probe of the test
% (docs/spec.md §3.9.3): the instance's items are added in order; any running item finishes.

map I_n: Inst -> Nat;
    I_c: Inst # Nat -> Kind;
    I_g: Inst # Nat -> Grp;
    I_h: Inst # Nat -> Bool;

act e_add: Item # Kind # Grp # Bool;
    e_done, e_run: Item;
    add: Item # Kind # Grp # Bool;
    done, run: Item;

proc Env(ins: Inst, k: Nat, run: FSet(Item)) =
    (k < I_n(ins)) -> e_add(item(k), I_c(ins, k), I_g(ins, k), I_h(ins, k)) . Env(k = k + 1)
  + sum i: Item . e_run(i) . Env(run = run + {i})
  + sum i: Item . (i in run) -> e_done(i) . Env(run = run - {i});

proc CoreStart =
  Core(0, lambda i: Item . 0, lambda i: Item . KANY, lambda i: Item . 0, lambda i: Item . false,
       lambda k: Kind . 0, lambda g: Nat . 0);

act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart;
     EnvSel = sum i: Inst . e_pick(i) . Env(i, 0, {});
     System =
  allow({ pick, add, done, run
%@obs-allow
        },
  comm({ c_pick | e_pick -> pick,
         c_add | e_add -> add,
         c_done | e_done -> done,
         c_run | e_run -> run },
    CoreSel || EnvSel));
