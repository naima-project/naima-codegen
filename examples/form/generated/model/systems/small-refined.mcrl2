% GENERATED by naima-codegen (docs/spec.md §3.9.7) from the Core named in its
% file name, the model's env.mcrl2 and instances/{never.mcrl2, once.mcrl2}. Do not edit.

sort Inst = struct i_never | i_once;

% GENERATED FILE: DO NOT EDIT.
% Generated by naima-codegen from the model's core.mcrl2, codegen.toml and
% policy.toml; see MANIFEST.json in the generated directory (docs/spec.md §3.1.3).
% Any edit here is lost at the next generation, and naima-codegen generate --check
% refuses the project while this file differs from what the model generates.
% To change it: change the model, verify its properties, run
% naima-codegen generate, and commit the model and the generated directory together.
% core.mcrl2 -- a form that sends what was typed and waits for the answer, written as
% one linear process (docs/spec.md §3.5): every summand is
% condition -> c_<label>(args) . Core(assignments).
%
% The user edits the form (c_edit says whether what is typed is valid) and submits it.
% Submitting queues a send; sending is the form's own decision (c_send, an output,
% which the user interface carries out through its port) and carries the attempt
% number. The answer comes back as an input: c_succeeded ends the form, c_failed
% lets the user edit again or resubmit while attempts are left. Each summand follows
% a tag line, %@input or %@order <level>.

sort Phase = struct EDITING | SENDING | SENT | FAILED;

act  c_edit: Bool;
     c_submit, c_succeeded, c_failed;
     c_send: Nat;

% ---- the policy's maps and the reference definitions of the selection operations
% (docs/spec.md §3.7.1, §3.7.4)

% ---- the enabledness of the refined outputs (docs/spec.md §3.7.2)
map ix_en_0: Bool -> Bool;
var ix_p_queued: Bool;
eqn ix_en_0(ix_p_queued) = (ix_p_queued);
map ix_quiet: Bool -> Bool;
var ix_p_queued: Bool;
eqn ix_quiet(ix_p_queued) = !ix_en_0(ix_p_queued);

act o_queued, o_tries, o_unsent;

proc Core(
  limit: Nat,
  phase: Phase,
  valid: Bool,
  tries: Nat,
  queued: Bool
) =
   % c_edit input
sum v: Bool .
    (((phase == EDITING || phase == FAILED)) && ix_quiet(queued)) ->
    c_edit(v) .
    Core(phase = EDITING,
         valid = v)

 + % c_submit input
((((phase == EDITING || phase == FAILED) && valid && tries < limit)) && ix_quiet(queued)) ->
    c_submit .
    Core(phase = SENDING,
         queued = true)

 + % c_succeeded input
(((phase == SENDING && !queued)) && ix_quiet(queued)) ->
    c_succeeded .
    Core(phase = SENT)

 + % c_failed input
(((phase == SENDING && !queued)) && ix_quiet(queued)) ->
    c_failed .
    Core(phase = FAILED,
         tries = tries + 1)

 + % c_send output c_send
(ix_en_0(queued)) ->
    c_send(tries + 1) .
    Core(queued = false)


  % a send is queued only while the form is sending
  + (queued && phase != SENDING) -> o_queued . Core()
  % never more failed attempts than the form allows
  + (tries > limit) -> o_tries . Core()
  % at the end of a step a submitted form has been sent
  + (ix_quiet(queued) && queued) -> o_unsent . Core()
  + delta;

% env.mcrl2 -- the environment of the form (never generated): the user, who edits and
% submits only what the form allows (a user interface enables exactly those
% controls), and the server, which answers every send, failing the first ones as the
% instance says. Everything an instance fixes is a map I_* defined in
% instances/<name>.mcrl2, taking the instance (sort Inst, declared by the generator).

map I_limit: Inst -> Nat;          % the attempts the form allows
    I_fails: Inst -> Nat;          % how many sends the server fails before one succeeds

act e_edit, edit: Bool;
    e_submit, e_succeeded, e_failed, submit, succeeded, failed;
    e_send, send: Nat;

% ins: the instance; f: failures left; w: a submit waits for its answer; busy: the
% server holds a send; done: the form was sent; v: what is typed is valid; t: attempts failed
proc Env(ins: Inst, f: Nat, w: Bool, busy: Bool, done: Bool, v: Bool, t: Nat) =
    (!w && !done) -> sum x: Bool . e_edit(x) . Env(v = x)
  + (!w && !done && v && t < I_limit(ins)) -> e_submit . Env(w = true)
  + sum n: Nat . e_send(n) . Env(busy = true)
  + (busy && f > 0) -> e_failed . Env(f = Int2Nat(f - 1), w = false, busy = false, t = t + 1)
  + (busy && f == 0) -> e_succeeded . Env(w = false, busy = false, done = true);

% Core's initial state for a configuration (the generator appends the refined Core's
% extra parameters to this call).
proc CoreStart(limit: Nat) =
  Core(limit, EDITING, false, 0, false);

% ---- the system: Core and the environment agree on the instance, then run
act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart(I_limit(i));
     EnvSel = sum i: Inst . e_pick(i) . Env(i, I_fails(i), false, false, false, false, 0);
     System =
  allow({ pick, edit, submit, succeeded, failed, send
, o_queued, o_tries, o_unsent
        },
  comm({ c_pick | e_pick -> pick,
         c_edit | e_edit -> edit,
         c_submit | e_submit -> submit,
         c_succeeded | e_succeeded -> succeeded,
         c_failed | e_failed -> failed,
         c_send | e_send -> send },
    CoreSel || EnvSel));

% never: two attempts allowed; the server fails every send.
eqn I_limit(i_never) = 2;  I_fails(i_never) = 5;

% once: three attempts allowed; the server fails the first send.
eqn I_limit(i_once) = 3;  I_fails(i_once) = 1;

init System;
