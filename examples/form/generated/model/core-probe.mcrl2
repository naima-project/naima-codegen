    Core(phase = SENDING,
         queued = true)

 + % c_succeeded input
(((phase == SENDING && !queued)) && ix_quiet(queued)) ->
    c_succeeded .
    Core(phase = SENT)

 + % c_failed input
(((phase == SENDING && !queued)) && ix_quiet(queued)) ->
    c_failed .
