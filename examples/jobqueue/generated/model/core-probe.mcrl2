 + sum j: Job . ((st(j) == FAILED && !spent(tries(j)))) -> probe_enabled . Core()
 + sum j: Job . ((j in Q && slots > 0)) -> probe_enabled . Core()
 + (ix_quiet(nj, st, tries, Q, slots, ix_retryable)) -> probe_quiet . Core()
