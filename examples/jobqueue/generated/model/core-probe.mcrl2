proc Core(
  w: Nat,
  nj: Nat,
  st: Job -> JSt,
  tries: Job -> Nat,
  Q: FSet(Job),
  slots: Nat,
  entered: JSt -> Nat,
  byTries: Nat -> Nat,
  ix_retryable: List(Job)
