% core.mcrl2 -- a job queue with a fixed number of workers, written as one linear
% process (docs/spec.md §3.5): every summand is  condition -> c_<label>(args) . Core(assignments).
%
% Clients submit jobs, numbered in submission order. A queued job starts when a worker
% slot is free; a running job finishes or crashes. A crashed job is queued again while
% it has tries left, and is given up after `retries` tries. Inputs come from the
% environment (submit, finished, crashed); outputs are the queue's decisions (start,
% retry, give_up). Each summand follows a tag line, %@input or %@order <level>.

sort Job = struct J0 | J1 | J2;
map job: Nat -> Job; jx: Job -> Nat;
eqn job(0) = J0; jx(J0) = 0; job(1) = J1; jx(J1) = 1; job(2) = J2; jx(J2) = 2;                        % the id sort
sort JSt = struct FREE | QUEUED | RUNNING | FAILED | DONE | GAVEUP;

map  retries: Nat;                                     % tries a job gets before it is given up
     spent: Nat -> Bool;                               % no try left after this many
var  t: Nat;
eqn  retries = 2;
     spent(t) = t >= retries;

act  c_submit, c_finished, c_crashed: Job;
     c_start, c_retry, c_give_up: Job;

% ---- the policy's maps and the reference definitions of the selection operations
% (docs/spec.md §3.7.1, §3.7.4)
map ix_least_Job: FSet(Job) # Nat -> Job;
var ix_s: FSet(Job); ix_i: Nat;
eqn job(ix_i) in ix_s -> ix_least_Job(ix_s, ix_i) = job(ix_i);
    !(job(ix_i) in ix_s) -> ix_least_Job(ix_s, ix_i) = ix_least_Job(ix_s, ix_i + 1);
% index retryable
map ix_mem_retryable: (Job -> JSt) # (Job -> Nat) # Job -> Bool;
var ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat; ix_v: Job;
eqn ix_mem_retryable(ix_p_st, ix_p_tries, ix_v) = ix_p_st(ix_v) == FAILED && ix_p_tries(ix_v) < retries;
map ix_bound_retryable: Nat -> Nat;
var ix_p_nj: Nat;
eqn ix_bound_retryable(ix_p_nj) = ix_p_nj;
map ix_ok_retryable: (Job -> JSt) # (Job -> Nat) # Job -> Bool;
var ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat; ix_v: Job;
eqn ix_ok_retryable(ix_p_st, ix_p_tries, ix_v) = ix_mem_retryable(ix_p_st, ix_p_tries, ix_v);
map ix_first_retryable: List(Job) -> Job;
map ix_some_retryable: List(Job) -> Bool;
var ix_y: Job; ix_l: List(Job);
eqn ix_first_retryable([]) = job(0);
    ix_first_retryable(ix_y |> ix_l) = if(true, ix_y, ix_first_retryable(ix_l));
    ix_some_retryable([]) = false;
    ix_some_retryable(ix_y |> ix_l) = true || ix_some_retryable(ix_l);
map ix_upd_retryable: List(Job) # Job # Bool # Bool -> List(Job);
    ix_rm_retryable: List(Job) # Job -> List(Job);
var ix_l: List(Job); ix_y, ix_x: Job; ix_a, ix_b: Bool;
eqn ix_upd_retryable(ix_l, ix_y, ix_a, ix_b) = if(ix_b && !ix_a, if(ix_y in ix_l, ix_l, ix_l <| ix_y), if(ix_a && !ix_b, ix_rm_retryable(ix_l, ix_y), ix_l));
    ix_rm_retryable([], ix_y) = [];
    ix_rm_retryable(ix_x |> ix_l, ix_y) = if(ix_x == ix_y, ix_l, ix_x |> ix_rm_retryable(ix_l, ix_y));
% index spent
map ix_mem_spent: (Job -> JSt) # (Job -> Nat) # Job -> Bool;
var ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat; ix_v: Job;
eqn ix_mem_spent(ix_p_st, ix_p_tries, ix_v) = ix_p_st(ix_v) == FAILED && ix_p_tries(ix_v) >= retries;
map ix_bound_spent: Nat -> Nat;
var ix_p_nj: Nat;
eqn ix_bound_spent(ix_p_nj) = ix_p_nj;
map ix_ok_spent: (Job -> JSt) # (Job -> Nat) # Job -> Bool;
var ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat; ix_v: Job;
eqn ix_ok_spent(ix_p_st, ix_p_tries, ix_v) = ix_mem_spent(ix_p_st, ix_p_tries, ix_v);
map ix_some_spent: (Job -> JSt) # (Job -> Nat) # Nat # Nat -> Bool;
var ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat; ix_p_nj: Nat; ix_i: Nat;
eqn ix_i >= ix_bound_spent(ix_p_nj) -> ix_some_spent(ix_p_st, ix_p_tries, ix_p_nj, ix_i) = false;
    ix_i < ix_bound_spent(ix_p_nj) && ix_ok_spent(ix_p_st, ix_p_tries, job(ix_i)) -> ix_some_spent(ix_p_st, ix_p_tries, ix_p_nj, ix_i) = true;
    ix_i < ix_bound_spent(ix_p_nj) && !ix_ok_spent(ix_p_st, ix_p_tries, job(ix_i)) -> ix_some_spent(ix_p_st, ix_p_tries, ix_p_nj, ix_i) = ix_some_spent(ix_p_st, ix_p_tries, ix_p_nj, ix_i + 1);
map ix_first_spent: (Job -> JSt) # (Job -> Nat) # Nat # Nat -> Job;
var ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat; ix_p_nj: Nat; ix_i: Nat;
eqn ix_i >= ix_bound_spent(ix_p_nj) -> ix_first_spent(ix_p_st, ix_p_tries, ix_p_nj, ix_i) = job(0);
    ix_i < ix_bound_spent(ix_p_nj) && ix_ok_spent(ix_p_st, ix_p_tries, job(ix_i)) -> ix_first_spent(ix_p_st, ix_p_tries, ix_p_nj, ix_i) = job(ix_i);
    ix_i < ix_bound_spent(ix_p_nj) && !ix_ok_spent(ix_p_st, ix_p_tries, job(ix_i)) -> ix_first_spent(ix_p_st, ix_p_tries, ix_p_nj, ix_i) = ix_first_spent(ix_p_st, ix_p_tries, ix_p_nj, ix_i + 1);

% ---- the enabledness of the refined outputs (docs/spec.md §3.7.2)
map ix_en_0: Nat # (Job -> JSt) # (Job -> Nat) -> Bool;
var ix_p_nj: Nat; ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat;
eqn ix_en_0(ix_p_nj, ix_p_st, ix_p_tries) = ((ix_some_spent(ix_p_st, ix_p_tries, ix_p_nj, 0))) && ((ix_p_st((ix_first_spent(ix_p_st, ix_p_tries, ix_p_nj, 0))) == FAILED && spent(ix_p_tries((ix_first_spent(ix_p_st, ix_p_tries, ix_p_nj, 0))))));
map ix_en_1: (Job -> JSt) # (Job -> Nat) # List(Job) -> Bool;
var ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat; ix_p_ix_retryable: List(Job);
eqn ix_en_1(ix_p_st, ix_p_tries, ix_p_ix_retryable) = ((ix_some_retryable(ix_p_ix_retryable))) && ((ix_p_st((ix_first_retryable(ix_p_ix_retryable))) == FAILED && !spent(ix_p_tries((ix_first_retryable(ix_p_ix_retryable))))));
map ix_en_2: FSet(Job) # Nat -> Bool;
var ix_p_Q: FSet(Job); ix_p_slots: Nat;
eqn ix_en_2(ix_p_Q, ix_p_slots) = ((ix_p_Q != {})) && (((ix_least_Job(ix_p_Q, 0)) in ix_p_Q && ix_p_slots > 0));
map ix_quiet: Nat # (Job -> JSt) # (Job -> Nat) # FSet(Job) # Nat # List(Job) -> Bool;
var ix_p_nj: Nat; ix_p_st: Job -> JSt; ix_p_tries: Job -> Nat; ix_p_Q: FSet(Job); ix_p_slots: Nat; ix_p_ix_retryable: List(Job);
eqn ix_quiet(ix_p_nj, ix_p_st, ix_p_tries, ix_p_Q, ix_p_slots, ix_p_ix_retryable) = !ix_en_0(ix_p_nj, ix_p_st, ix_p_tries) && !ix_en_1(ix_p_st, ix_p_tries, ix_p_ix_retryable) && !ix_en_2(ix_p_Q, ix_p_slots);

act probe_enabled, probe_quiet, probe_ambiguous, probe_refused, probe_ambiguous_in;

proc Core(
  w: Nat,
  nj: Nat,
  st: Job -> JSt,
  tries: Job -> Nat,
  Q: FSet(Job),
  slots: Nat,
  entered: JSt -> Nat,
  byTries: Nat -> Nat,
  ix_retryable: List(Job)
) =
   % c_submit input
sum j: Job .
    (((jx(j) == nj)) && ix_quiet(nj, st, tries, Q, slots, ix_retryable)) ->
    c_submit(j) .
    Core(nj = nj + 1,
         st = st[j -> QUEUED],
         Q = Q + {j},
         entered = entered[QUEUED -> entered(QUEUED) + 1],
         ix_retryable = ix_upd_retryable(ix_retryable, (j), ix_mem_retryable(st, tries, (j)), ix_mem_retryable((st[j -> QUEUED]), tries, (j))))

 + % c_finished input
sum j: Job .
    (((st(j) == RUNNING)) && ix_quiet(nj, st, tries, Q, slots, ix_retryable)) ->
    c_finished(j) .
    Core(st = st[j -> DONE],
         slots = slots + 1,
         entered = entered[DONE -> entered(DONE) + 1],
         ix_retryable = ix_upd_retryable(ix_retryable, (j), ix_mem_retryable(st, tries, (j)), ix_mem_retryable((st[j -> DONE]), tries, (j))))

 + % c_crashed input
sum j: Job .
    (((st(j) == RUNNING)) && ix_quiet(nj, st, tries, Q, slots, ix_retryable)) ->
    c_crashed(j) .
    Core(st = st[j -> FAILED],
         slots = slots + 1,
         entered = entered[FAILED -> entered(FAILED) + 1],
         ix_retryable = ix_upd_retryable(ix_retryable, (j), ix_mem_retryable(st, tries, (j)), ix_mem_retryable((st[j -> FAILED]), tries, (j))))

 + % c_give_up output c_give_up
(ix_en_0(nj, st, tries)) ->
    c_give_up((ix_first_spent(st, tries, nj, 0))) .
    Core(st = st[(ix_first_spent(st, tries, nj, 0)) -> GAVEUP],
         entered = entered[GAVEUP -> entered(GAVEUP) + 1],
         ix_retryable = ix_upd_retryable(ix_retryable, ((ix_first_spent(st, tries, nj, 0))), ix_mem_retryable(st, tries, ((ix_first_spent(st, tries, nj, 0)))), ix_mem_retryable((st[(ix_first_spent(st, tries, nj, 0)) -> GAVEUP]), tries, ((ix_first_spent(st, tries, nj, 0))))))

 + % c_retry output c_retry
(ix_en_1(st, tries, ix_retryable) && !ix_en_0(nj, st, tries)) ->
    c_retry((ix_first_retryable(ix_retryable))) .
    Core(st = st[(ix_first_retryable(ix_retryable)) -> QUEUED],
         Q = Q + {(ix_first_retryable(ix_retryable))},
         entered = entered[QUEUED -> entered(QUEUED) + 1],
         ix_retryable = ix_upd_retryable(ix_retryable, ((ix_first_retryable(ix_retryable))), ix_mem_retryable(st, tries, ((ix_first_retryable(ix_retryable)))), ix_mem_retryable((st[(ix_first_retryable(ix_retryable)) -> QUEUED]), tries, ((ix_first_retryable(ix_retryable))))))

 + % c_start output c_start
(ix_en_2(Q, slots) && !ix_en_0(nj, st, tries) && !ix_en_1(st, tries, ix_retryable)) ->
    c_start((ix_least_Job(Q, 0))) .
    Core(Q = Q - {(ix_least_Job(Q, 0))},
         st = st[(ix_least_Job(Q, 0)) -> RUNNING],
         slots = Int2Nat(slots - 1),
         tries = tries[(ix_least_Job(Q, 0)) -> tries((ix_least_Job(Q, 0))) + 1],
         entered = entered[RUNNING -> entered(RUNNING) + 1],
         byTries = byTries[tries((ix_least_Job(Q, 0))) + 1 -> byTries(tries((ix_least_Job(Q, 0))) + 1) + 1],
         ix_retryable = ix_upd_retryable(ix_retryable, ((ix_least_Job(Q, 0))), ix_mem_retryable(st, tries, ((ix_least_Job(Q, 0)))), ix_mem_retryable((st[(ix_least_Job(Q, 0)) -> RUNNING]), (tries[(ix_least_Job(Q, 0)) -> tries((ix_least_Job(Q, 0))) + 1]), ((ix_least_Job(Q, 0))))))
 + sum j: Job . ((st(j) == FAILED && spent(tries(j)))) -> probe_enabled . Core()
 + sum j: Job . ((st(j) == FAILED && !spent(tries(j)))) -> probe_enabled . Core()
 + sum j: Job . ((j in Q && slots > 0)) -> probe_enabled . Core()
 + (ix_quiet(nj, st, tries, Q, slots, ix_retryable)) -> probe_quiet . Core()
 + sum rf_0: Job . ((ix_quiet(nj, st, tries, Q, slots, ix_retryable)) && !((((jx((rf_0)) == nj))))) -> c_submit(rf_0)|probe_refused . delta
 + sum rf_0: Job . ((ix_quiet(nj, st, tries, Q, slots, ix_retryable)) && !((((st((rf_0)) == RUNNING))))) -> c_finished(rf_0)|probe_refused . delta
 + sum rf_0: Job . ((ix_quiet(nj, st, tries, Q, slots, ix_retryable)) && !((((st((rf_0)) == RUNNING))))) -> c_crashed(rf_0)|probe_refused . delta

%@observers
  + delta;

% env.mcrl2 -- the environment of the job queue (never generated): the clients, who
% submit the instance's jobs in order, and the workers, who finish or crash every job
% they are given. Everything an instance fixes is a map I_* defined in
% instances/<name>.mcrl2; every map takes the instance (sort Inst, declared by the
% generator in each system), so that one system holds several instances side by side.

map I_w: Inst -> Nat;              % workers
    I_jobs: Inst -> Nat;           % jobs the clients submit
    I_crash: Inst # Job -> Nat;    % how many times a job crashes before it finishes

act e_submit, e_finished, e_crashed, e_start, e_retry, e_give_up: Job;
    submit, finished, crashed, start, retry, give_up: Job;

% ins: the instance; k: jobs submitted; run: the jobs at a worker; cr: crashes left per job
proc Env(ins: Inst, k: Nat, run: FSet(Job), cr: Job -> Nat) =
    (k < I_jobs(ins)) -> e_submit(job(k)) . Env(k = k + 1)
  + sum j: Job . e_start(j) . Env(run = run + {j})
  + sum j: Job . (j in run && cr(j) == 0) -> e_finished(j) . Env(run = run - {j})
  + sum j: Job . (j in run && cr(j) > 0) -> e_crashed(j) . Env(run = run - {j}, cr = cr[j -> Int2Nat(cr(j) - 1)])
  + sum j: Job . e_retry(j) . Env()
  + sum j: Job . e_give_up(j) . Env();

% Core's initial state for a configuration (the generator appends the refined Core's
% extra parameters to this call).
proc CoreStart(w: Nat) =
  Core(w, 0, lambda j: Job . FREE, lambda j: Job . 0, {}, w, lambda s: JSt . 0, lambda t: Nat . 0, []);

% ---- the system: Core and the environment agree on the instance, then run
act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart(I_w(i));
     EnvSel = sum i: Inst . e_pick(i) . Env(i, 0, {}, lambda j: Job . I_crash(i, j));
     System =
  allow({ pick, submit, finished, crashed, start, retry, give_up
, probe_enabled, probe_quiet, probe_ambiguous, crashed|probe_refused, finished|probe_refused, submit|probe_refused
        },
  comm({ c_pick | e_pick -> pick,
         c_submit | e_submit -> submit,
         c_finished | e_finished -> finished,
         c_crashed | e_crashed -> crashed,
         c_start | e_start -> start,
         c_retry | e_retry -> retry,
         c_give_up | e_give_up -> give_up },
    CoreSel || EnvSel));

% @jobs 2
% one: one worker, two jobs, the first crashes once and is retried.
var j: Job;
eqn I_w(i_one) = 1;  I_jobs(i_one) = 2;  I_crash(i_one, j) = if(j == J0, 1, 0);

% @jobs 3
% three: two workers, three jobs: one waits in the queue, the last crashes once.
var j: Job;
eqn I_w(i_three) = 2;  I_jobs(i_three) = 3;  I_crash(i_three, j) = if(j == J2, 1, 0);

% @jobs 2
% two: two workers, two jobs that both finish at once.
var j: Job;
eqn I_w(i_two) = 2;  I_jobs(i_two) = 2;  I_crash(i_two, j) = 0;

init System;
