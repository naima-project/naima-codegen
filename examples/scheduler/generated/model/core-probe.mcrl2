act probe_enabled, probe_quiet, probe_ambiguous, probe_refused, probe_ambiguous_in;

proc Core(
  w: Nat,
  nt: Nat,
  begun: Bool,
  ended: Bool,
  free: Nat,
  pending: Nat,
  settled: Nat,
  st: Task -> TSt,
  kids: Task -> List(Task),
  isgoal: Task -> Bool,
  told: Task -> Bool,
  users: Task -> List(Task),
  missing: Task -> Nat,
  broken: Task -> Bool,
  todo: Task -> List(Task)
) =
   % c_define input
sum t: Task, ks: List(Task) .
    (((!begun && tx(t) == nt && below(ks, nt))) && ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) ->
    c_define(t, ks) .
    Core(nt = nt + 1,
         st = st[t -> WAITING],
         kids = kids[t -> ks],
         users = adduser(ks, t, users),
         missing = missing[t -> #ks])

 + % c_goal input
sum t: Task .
    (((!begun && tx(t) < nt && !isgoal(t))) && ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) ->
    c_goal(t) .
    Core(isgoal = isgoal[t -> true],
         pending = pending + 1)

 + % c_run input
(((!begun && nt > 0)) && ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) ->
    c_run .
    Core(begun = true)

 + % c_finished input
sum t: Task .
    (((st(t) == RUNNING)) && ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) ->
    c_finished(t) .
    Core(st = st[t -> DONE],
         free = free + 1,
         settled = settled + 1,
         todo = todo[t -> users(t)])

 + % c_failed input
sum t: Task .
    (((st(t) == RUNNING)) && ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) ->
    c_failed(t) .
    Core(st = st[t -> FAILED],
         free = free + 1,
         settled = settled + 1,
         todo = todo[t -> users(t)])

 + % c_deliver output c_deliver
(ix_en_0(nt, begun, st, isgoal, told)) ->
    c_deliver((t whr t = ix_first_due(st, isgoal, told, nt, 0) end), (((st(t) == DONE)) whr t = ix_first_due(st, isgoal, told, nt, 0) end)) .
    Core(told = told[(t  whr t = ix_first_due(st, isgoal, told, nt, 0) end)-> true],
         pending = Int2Nat(pending - 1))

 + % c_tell output c_tell
(ix_en_1(nt, st, todo) && !ix_en_0(nt, begun, st, isgoal, told)) ->
    c_tell((t whr t = ix_first_telling(st, todo, nt, 0) end), ((head(todo(t))) whr t = ix_first_telling(st, todo, nt, 0) end)) .
    Core(todo = todo[(t  whr t = ix_first_telling(st, todo, nt, 0) end)->( tail(todo(t)) whr t = ix_first_telling(st, todo, nt, 0) end)],
         missing = missing[((head(todo(t)))  whr t = ix_first_telling(st, todo, nt, 0) end)->( if(st(t) == DONE, Int2Nat(missing((head(todo(t)))) - 1), missing((head(todo(t))))) whr t = ix_first_telling(st, todo, nt, 0) end)],
         broken = broken[((head(todo(t)))  whr t = ix_first_telling(st, todo, nt, 0) end)->( broken((head(todo(t)))) || st(t) == FAILED whr t = ix_first_telling(st, todo, nt, 0) end)])

 + % c_abandon output c_abandon
(ix_en_2(nt, begun, st, broken) && !ix_en_0(nt, begun, st, isgoal, told) && !ix_en_1(nt, st, todo)) ->
    c_abandon((t whr t = ix_first_doomed(st, broken, nt, 0) end)) .
    Core(st = st[(t  whr t = ix_first_doomed(st, broken, nt, 0) end)-> FAILED],
         settled = settled + 1,
         todo = todo[(t  whr t = ix_first_doomed(st, broken, nt, 0) end)->( users(t) whr t = ix_first_doomed(st, broken, nt, 0) end)])

 + % c_ready output c_ready
(ix_en_3(nt, begun, st, missing, broken) && !ix_en_0(nt, begun, st, isgoal, told) && !ix_en_1(nt, st, todo) && !ix_en_2(nt, begun, st, broken)) ->
    c_ready((t whr t = ix_first_runnable(st, missing, broken, nt, 0) end)) .
    Core(st = st[(t  whr t = ix_first_runnable(st, missing, broken, nt, 0) end)-> READY])

 + % c_start output c_start
(ix_en_4(nt, free, st) && !ix_en_0(nt, begun, st, isgoal, told) && !ix_en_1(nt, st, todo) && !ix_en_2(nt, begun, st, broken) && !ix_en_3(nt, begun, st, missing, broken)) ->
    c_start((t whr t = ix_first_queued(st, nt, 0) end)) .
    Core(st = st[(t  whr t = ix_first_queued(st, nt, 0) end)-> RUNNING],
         free = Int2Nat(free - 1))

 + % c_finish output c_finish
(ix_en_5(nt, begun, ended, pending, settled) && !ix_en_0(nt, begun, st, isgoal, told) && !ix_en_1(nt, st, todo) && !ix_en_2(nt, begun, st, broken) && !ix_en_3(nt, begun, st, missing, broken) && !ix_en_4(nt, free, st)) ->
    c_finish .
    Core(ended = true)
 + sum t: Task, b: Bool . ((begun && isgoal(t) && !told(t) && (st(t) == DONE || st(t) == FAILED) && b == (st(t) == DONE))) -> probe_enabled . Core()
 + sum t: Task, v: Task . (((st(t) == DONE || st(t) == FAILED) && todo(t) != [] && v == head(todo(t)))) -> probe_enabled . Core()
 + sum t: Task . ((begun && st(t) == WAITING && broken(t))) -> probe_enabled . Core()
 + sum t: Task . ((begun && st(t) == WAITING && missing(t) == 0 && !broken(t))) -> probe_enabled . Core()
 + sum t: Task . ((free > 0 && st(t) == READY)) -> probe_enabled . Core()
 + ((begun && !ended && settled == nt && pending == 0)) -> probe_enabled . Core()
 + (ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) -> probe_quiet . Core()
 + sum rf_0: Task, rf_1: List(Task) . ((ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) && !((((!begun && tx((rf_0)) == nt && below((rf_1), nt)))))) -> c_define(rf_0, rf_1)|probe_refused . delta
 + sum rf_0: Task . ((ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) && !((((!begun && tx((rf_0)) < nt && !isgoal((rf_0))))))) -> c_goal(rf_0)|probe_refused . delta
 + ((ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) && !((((!begun && nt > 0))))) -> c_run|probe_refused . delta
 + sum rf_0: Task . ((ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) && !((((st((rf_0)) == RUNNING))))) -> c_finished(rf_0)|probe_refused . delta
 + sum rf_0: Task . ((ix_quiet(nt, begun, ended, free, pending, settled, st, isgoal, told, missing, broken, todo)) && !((((st((rf_0)) == RUNNING))))) -> c_failed(rf_0)|probe_refused . delta

%@observers
  + delta;
