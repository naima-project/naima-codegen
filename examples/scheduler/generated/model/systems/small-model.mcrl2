% GENERATED by naima-codegen (docs/spec.md §3.9.7) from the Core named in its
% file name, the model's env.mcrl2 and instances/{five.mcrl2}. Do not edit.

sort Inst = struct i_five;

% core.mcrl2 -- a pool scheduler: a fixed number of workers runs a small task graph.
% One linear process in naima-codegen's form: every summand is
%   condition -> c_<label>(args) . Core(assignments)
% and follows a tag line, %@input for what the environment says, %@order <level> for
% what the scheduler decides itself.
%
% Before the run, the environment gives the tasks, each with the earlier tasks it reads,
% and marks some of them as goals. It then starts the run. From then on the scheduler
% marks a task ready once everything it reads is done, gives the oldest ready task to a
% free worker, and delivers each goal once it is done or has failed. The environment
% reports every task that runs as finished or failed. A task that reads a failed task
% fails without running.

sort Task = struct T0 | T1 | T2 | T3 | T4;
map task: Nat -> Task; tx: Task -> Nat;
eqn task(0) = T0; tx(T0) = 0; task(1) = T1; tx(T1) = 1; task(2) = T2; tx(T2) = 2; task(3) = T3; tx(T3) = 3; task(4) = T4; tx(T4) = 4;                       % the id sort: tasks, oldest first
sort TSt = struct ABSENT | WAITING | READY | RUNNING | DONE | FAILED;

map below: List(Task) # Nat -> Bool;                    % every task in the list is older than n
map adduser: List(Task) # Task # (Task -> List(Task)) -> (Task -> List(Task));  % t joins the users of every task in the list
var kk: Task;  l: List(Task);  n: Nat;  t: Task;  u: Task -> List(Task);
eqn below([], n) = true;
    below(kk |> l, n) = (tx(kk) < n) && below(l, n);
    adduser([], t, u) = u;
    adduser(kk |> l, t, u) = adduser(l, t, u[kk -> u(kk) <| t]);

act  c_define: Task # List(Task);                         % a task, and the tasks it reads
     c_goal, c_finished, c_failed: Task;                % a goal; a task reported finished or failed
     c_run;                                             % the program is complete: start
     c_ready, c_start, c_abandon: Task;                 % the scheduler's own steps
     c_tell: Task # Task;                               % a settled task tells one that reads it
     c_deliver: Task # Bool;                            % a goal's result: true when it is done
     c_finish;                                          % every goal delivered, nothing left

% w: workers; nt: tasks given; begun: the run has started; ended: the run is finished;
% free: workers without a task; pending: goals not yet delivered; settled: tasks done or failed;
% st: where each task stands; kids: the tasks each task reads; isgoal: whether a task is a goal;
% told: whether a goal's result was delivered; users: the tasks that read each task;
% missing: how many of the tasks a task reads are not done yet; broken: a task it reads failed;
% todo: the users a settled task has still to tell
proc Core(w: Nat, nt: Nat, begun: Bool, ended: Bool, free: Nat, pending: Nat, settled: Nat,
          st: Task -> TSt, kids: Task -> List(Task), isgoal: Task -> Bool, told: Task -> Bool,
          users: Task -> List(Task), missing: Task -> Nat, broken: Task -> Bool, todo: Task -> List(Task)) =
% ---- inputs: the program, before the run
%@input
    sum t: Task, ks: List(Task) . (!begun && tx(t) == nt && below(ks, nt)) ->
      c_define(t, ks) . Core(nt = nt + 1, st = st[t -> WAITING], kids = kids[t -> ks], users = adduser(ks, t, users),
                             missing = missing[t -> #ks])
%@input
  + sum t: Task . (!begun && tx(t) < nt && !isgoal(t)) ->
      c_goal(t) . Core(isgoal = isgoal[t -> true], pending = pending + 1)
%@input
  + (!begun && nt > 0) ->
      c_run . Core(begun = true)
% ---- inputs: the workers, during the run
%@input
  + sum t: Task . (st(t) == RUNNING) ->
      c_finished(t) . Core(st = st[t -> DONE], free = free + 1, settled = settled + 1, todo = todo[t -> users(t)])
%@input
  + sum t: Task . (st(t) == RUNNING) ->
      c_failed(t) . Core(st = st[t -> FAILED], free = free + 1, settled = settled + 1, todo = todo[t -> users(t)])

% ---- outputs: the scheduler's decisions
%@order 1
  + sum t: Task, b: Bool . (begun && isgoal(t) && !told(t) && (st(t) == DONE || st(t) == FAILED) && b == (st(t) == DONE)) ->
      c_deliver(t, b) . Core(told = told[t -> true], pending = Int2Nat(pending - 1))
%@order 2
  + sum t: Task, v: Task . ((st(t) == DONE || st(t) == FAILED) && todo(t) != [] && v == head(todo(t))) ->
      c_tell(t, v) . Core(todo = todo[t -> tail(todo(t))],
                          missing = missing[v -> if(st(t) == DONE, Int2Nat(missing(v) - 1), missing(v))],
                          broken = broken[v -> broken(v) || st(t) == FAILED])
%@order 3
  + sum t: Task . (begun && st(t) == WAITING && broken(t)) ->
      c_abandon(t) . Core(st = st[t -> FAILED], settled = settled + 1, todo = todo[t -> users(t)])
%@order 4
  + sum t: Task . (begun && st(t) == WAITING && missing(t) == 0 && !broken(t)) ->
      c_ready(t) . Core(st = st[t -> READY])
%@order 5
  + sum t: Task . (free > 0 && st(t) == READY) ->
      c_start(t) . Core(st = st[t -> RUNNING], free = Int2Nat(free - 1))
%@order 6
  + (begun && !ended && settled == nt && pending == 0) ->
      c_finish . Core(ended = true)

%@observers
  + delta;

% env.mcrl2 -- the environment of the scheduler as the real program has it (never generated): the program
% posts the tasks, the goals and the run to the inbox of the generic event loop; the loop takes the events
% one at a time, in order, and hands each to the scheduler; every action the scheduler returns goes to a
% handler. The handler of start(t) lets a thread run the task, which ends by posting finished(t) or
% failed(t) to the inbox; the handler of finish stops the loop. What an instance fixes is a map I_* defined in
% instances/<name>.mcrl2; every map takes the instance (sort Inst, declared by the
% generator in each system).

map I_w: Inst -> Nat;                  % workers
    I_n: Inst -> Nat;                  % tasks
    I_reads: Inst # Nat -> List(Nat);  % the tasks each task reads
    I_goal: Inst # Nat -> Bool;        % whether a task is a goal
    I_ng: Inst -> Nat;                 % how many goals
    tl: List(Nat) -> List(Task);       % task numbers as tasks
var m: Nat;  ms: List(Nat);
eqn tl([]) = [];
    tl(m |> ms) = task(m) |> tl(ms);

sort Msg = struct mDefine(mdt: Task, mdks: List(Task)) ?is_mDefine | mGoal(mgt: Task) ?is_mGoal | mRun ?is_mRun
                | mFinished(mft: Task) ?is_mFinished | mFailed(mlt: Task) ?is_mFailed | mStop ?is_mStop;

% e_*: an event the loop takes from the inbox, or an action the loop hands to a handler, in step with the scheduler
act e_define: Task # List(Task);
    e_goal, e_finished, e_failed, e_ready, e_start, e_abandon: Task;
    e_tell: Task # Task;
    e_deliver: Task # Bool;
    e_run, e_finish;
    define: Task # List(Task);
    goal, finished, failed, ready, start, abandon: Task;
    tell: Task # Task;
    deliver: Task # Bool;
    run, finish;
% p_*: the program, a thread or a handler posts to the inbox; s_*: the inbox receives; post_*: the two together
act p_define, s_define, post_define: Task # List(Task);
    p_goal, s_goal, post_goal, p_finished, s_finished, post_finished, p_failed, s_failed, post_failed: Task;
    p_run, s_run, post_run, p_stop, s_stop, post_stop;
    halt;                                  % the loop takes the stop and ends

% ins: the instance; k: tasks given; gd: goals given; go: the run has been posted
proc Main(ins: Inst, k: Nat, gd: FSet(Task), go: Bool) =
    (k < I_n(ins)) -> p_define(task(k), tl(I_reads(ins, k))) . Main(k = k + 1)
  + sum t: Task . (k == I_n(ins) && tx(t) < k && I_goal(ins, tx(t)) && !(t in gd)) -> p_goal(t) . Main(gd = gd + {t})
  + (k == I_n(ins) && #gd == I_ng(ins) && !go) -> p_run . Main(go = true);

% the inbox: a queue, first in first out; the loop takes the head only when the scheduler accepts it
proc Inbox(q: List(Msg)) =
    sum t: Task, ks: List(Task) . s_define(t, ks) . Inbox(q <| mDefine(t, ks))
  + sum t: Task . s_goal(t) . Inbox(q <| mGoal(t))
  + s_run . Inbox(q <| mRun)
  + sum t: Task . s_finished(t) . Inbox(q <| mFinished(t))
  + sum t: Task . s_failed(t) . Inbox(q <| mFailed(t))
  + s_stop . Inbox(q <| mStop)
  + (q != [] && is_mDefine(head(q))) -> e_define(mdt(head(q)), mdks(head(q))) . Inbox(tail(q))
  + (q != [] && is_mGoal(head(q))) -> e_goal(mgt(head(q))) . Inbox(tail(q))
  + (q != [] && is_mRun(head(q))) -> e_run . Inbox(tail(q))
  + (q != [] && is_mFinished(head(q))) -> e_finished(mft(head(q))) . Inbox(tail(q))
  + (q != [] && is_mFailed(head(q))) -> e_failed(mlt(head(q))) . Inbox(tail(q))
  + (q != [] && is_mStop(head(q))) -> halt . delta;

% the handlers: the tasks at a thread are the ones start was called for and that have not posted their end
proc Pool(at: FSet(Task)) =
    sum t: Task . e_start(t) . Pool(at = at + {t})
  + sum t: Task . (t in at) -> p_finished(t) . Pool(at = at - {t})
  + sum t: Task . (t in at) -> p_failed(t) . Pool(at = at - {t})
  + sum t: Task . e_ready(t) . Pool()
  + sum t: Task . e_abandon(t) . Pool()
  + sum t, v: Task . e_tell(t, v) . Pool()
  + sum t: Task, b: Bool . e_deliver(t, b) . Pool()
  + e_finish . p_stop . Pool();

% Core's initial state for a configuration (the generator appends the refined Core's
% extra parameters to this call).
proc CoreStart(w: Nat) =
  Core(w, 0, false, false, w, 0, 0, lambda t: Task . ABSENT, lambda t: Task . [], lambda t: Task . false, lambda t: Task . false,
       lambda t: Task . [], lambda t: Task . 0, lambda t: Task . false, lambda t: Task . []);

% ---- the system: Core and the environment agree on the instance, then run
act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart(I_w(i));
     MainSel = sum i: Inst . e_pick(i) . Main(i, 0, {}, false);
     EnvSel =
  comm({ p_define | s_define -> post_define, p_goal | s_goal -> post_goal, p_run | s_run -> post_run,
         p_finished | s_finished -> post_finished, p_failed | s_failed -> post_failed, p_stop | s_stop -> post_stop },
    MainSel || Inbox([]) || Pool({}));
     System =
  allow({ pick, define, goal, run, finished, failed, ready, start, abandon, tell, deliver, finish,
          post_define, post_goal, post_run, post_finished, post_failed, post_stop, halt

        },
  comm({ c_pick | e_pick -> pick,
         c_define | e_define -> define,
         c_goal | e_goal -> goal,
         c_run | e_run -> run,
         c_finished | e_finished -> finished,
         c_failed | e_failed -> failed,
         c_ready | e_ready -> ready,
         c_start | e_start -> start,
         c_abandon | e_abandon -> abandon,
         c_tell | e_tell -> tell,
         c_deliver | e_deliver -> deliver,
         c_finish | e_finish -> finish },
    CoreSel || EnvSel));

% @tasks 5
% five: two workers and five tasks. Tasks 0, 1 and 2 read nothing, so three tasks are ready at once and
% one of them waits for a worker. Task 3 reads tasks 0 and 1, task 4 reads tasks 2 and 3. Tasks 3 and 4 are
% the goals. Any task that runs may finish or fail.
var n: Nat;
eqn I_w(i_five) = 2;  I_n(i_five) = 5;
    I_reads(i_five, n) = if(n == 3, [0, 1], if(n == 4, [2, 3], []));
    I_goal(i_five, n) = (n == 3 || n == 4);  I_ng(i_five) = 2;

init System;
