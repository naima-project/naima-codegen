% env.mcrl2 -- the environment of the scheduler as the real program has it (never generated): the program
% posts the tasks, the goals and the run to the inbox of the generic event loop; the loop takes the events
% one at a time, in order, and hands each to the scheduler; every action the scheduler returns goes to a
% handler. The handler of start(t) lets a thread run the task, which ends by posting finished(t) or
% failed(t) to the inbox; the handler of finish stops the loop. What an instance fixes is a map I_* defined in
% instances/<name>.mcrl2; every map takes the instance (sort Inst, declared by the
% generator in each system).

map I_w: Inst -> Nat;                  % workers
    I_n: Inst -> Nat;                  % tasks
    I_reads: Inst # Nat -> List(Nat);  % the tasks each task reads
    I_goal: Inst # Nat -> Bool;        % whether a task is a goal
    I_ng: Inst -> Nat;                 % how many goals
    tl: List(Nat) -> List(Task);       % task numbers as tasks
var m: Nat;  ms: List(Nat);
eqn tl([]) = [];
    tl(m |> ms) = task(m) |> tl(ms);

sort Msg = struct mDefine(mdt: Task, mdks: List(Task)) ?is_mDefine | mGoal(mgt: Task) ?is_mGoal | mRun ?is_mRun
                | mFinished(mft: Task) ?is_mFinished | mFailed(mlt: Task) ?is_mFailed | mStop ?is_mStop;

% e_*: an event the loop takes from the inbox, or an action the loop hands to a handler, in step with the scheduler
act e_define: Task # List(Task);
    e_goal, e_finished, e_failed, e_ready, e_start, e_abandon: Task;
    e_tell: Task # Task;
    e_deliver: Task # Bool;
    e_run, e_finish;
    define: Task # List(Task);
    goal, finished, failed, ready, start, abandon: Task;
    tell: Task # Task;
    deliver: Task # Bool;
    run, finish;
% p_*: the program, a thread or a handler posts to the inbox; s_*: the inbox receives; post_*: the two together
act p_define, s_define, post_define: Task # List(Task);
    p_goal, s_goal, post_goal, p_finished, s_finished, post_finished, p_failed, s_failed, post_failed: Task;
    p_run, s_run, post_run, p_stop, s_stop, post_stop;
    halt;                                  % the loop takes the stop and ends

% ins: the instance; k: tasks given; gd: goals given; go: the run has been posted
proc Main(ins: Inst, k: Nat, gd: FSet(Task), go: Bool) =
    (k < I_n(ins)) -> p_define(task(k), tl(I_reads(ins, k))) . Main(k = k + 1)
  + sum t: Task . (k == I_n(ins) && tx(t) < k && I_goal(ins, tx(t)) && !(t in gd)) -> p_goal(t) . Main(gd = gd + {t})
  + (k == I_n(ins) && #gd == I_ng(ins) && !go) -> p_run . Main(go = true);

% the inbox: a queue, first in first out; the loop takes the head only when the scheduler accepts it
proc Inbox(q: List(Msg)) =
    sum t: Task, ks: List(Task) . s_define(t, ks) . Inbox(q <| mDefine(t, ks))
  + sum t: Task . s_goal(t) . Inbox(q <| mGoal(t))
  + s_run . Inbox(q <| mRun)
  + sum t: Task . s_finished(t) . Inbox(q <| mFinished(t))
  + sum t: Task . s_failed(t) . Inbox(q <| mFailed(t))
  + s_stop . Inbox(q <| mStop)
  + (q != [] && is_mDefine(head(q))) -> e_define(mdt(head(q)), mdks(head(q))) . Inbox(tail(q))
  + (q != [] && is_mGoal(head(q))) -> e_goal(mgt(head(q))) . Inbox(tail(q))
  + (q != [] && is_mRun(head(q))) -> e_run . Inbox(tail(q))
  + (q != [] && is_mFinished(head(q))) -> e_finished(mft(head(q))) . Inbox(tail(q))
  + (q != [] && is_mFailed(head(q))) -> e_failed(mlt(head(q))) . Inbox(tail(q))
  + (q != [] && is_mStop(head(q))) -> halt . delta;

% the handlers: the tasks at a thread are the ones start was called for and that have not posted their end
proc Pool(at: FSet(Task)) =
    sum t: Task . e_start(t) . Pool(at = at + {t})
  + sum t: Task . (t in at) -> p_finished(t) . Pool(at = at - {t})
  + sum t: Task . (t in at) -> p_failed(t) . Pool(at = at - {t})
  + sum t: Task . e_ready(t) . Pool()
  + sum t: Task . e_abandon(t) . Pool()
  + sum t, v: Task . e_tell(t, v) . Pool()
  + sum t: Task, b: Bool . e_deliver(t, b) . Pool()
  + e_finish . p_stop . Pool();

% Core's initial state for a configuration (the generator appends the refined Core's
% extra parameters to this call).
proc CoreStart(w: Nat) =
  Core(w, 0, false, false, w, 0, 0, lambda t: Task . ABSENT, lambda t: Task . [], lambda t: Task . false, lambda t: Task . false,
       lambda t: Task . [], lambda t: Task . 0, lambda t: Task . false, lambda t: Task . []);

% ---- the system: Core and the environment agree on the instance, then run
act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart(I_w(i));
     MainSel = sum i: Inst . e_pick(i) . Main(i, 0, {}, false);
     EnvSel =
  comm({ p_define | s_define -> post_define, p_goal | s_goal -> post_goal, p_run | s_run -> post_run,
         p_finished | s_finished -> post_finished, p_failed | s_failed -> post_failed, p_stop | s_stop -> post_stop },
    MainSel || Inbox([]) || Pool({}));
     System =
  allow({ pick, define, goal, run, finished, failed, ready, start, abandon, tell, deliver, finish,
          post_define, post_goal, post_run, post_finished, post_failed, post_stop, halt
%@obs-allow
        },
  comm({ c_pick | e_pick -> pick,
         c_define | e_define -> define,
         c_goal | e_goal -> goal,
         c_run | e_run -> run,
         c_finished | e_finished -> finished,
         c_failed | e_failed -> failed,
         c_ready | e_ready -> ready,
         c_start | e_start -> start,
         c_abandon | e_abandon -> abandon,
         c_tell | e_tell -> tell,
         c_deliver | e_deliver -> deliver,
         c_finish | e_finish -> finish },
    CoreSel || EnvSel));
