    Core(st = st[(ix_first_queue(st, rank, nt, 0, task(0), false)) -> Running],
         ix_telling = ix_ins_telling(ix_out_telling(ix_telling, if(ix_a1 && !ix_b1, {(ix_first_queue(st, rank, nt, 0, task(0), false))}, {})), if(ix_b1 && !ix_a1, {(ix_first_queue(st, rank, nt, 0, task(0), false))}, {}), 0) whr ix_a1 = ix_mem_telling(st, waiters, ((ix_first_queue(st, rank, nt, 0, task(0), false)))), ix_b1 = ix_mem_telling((st[(ix_first_queue(st, rank, nt, 0, task(0), false)) -> Running]), waiters, ((ix_first_queue(st, rank, nt, 0, task(0), false)))) end,
         ix_droppable = ix_ins_droppable(ix_out_droppable(ix_droppable, if(ix_a1 && !ix_b1, {(ix_first_queue(st, rank, nt, 0, task(0), false))}, {})), if(ix_b1 && !ix_a1, {(ix_first_queue(st, rank, nt, 0, task(0), false))}, {}), 0) whr ix_a1 = ix_mem_droppable(st, waiters, ((ix_first_queue(st, rank, nt, 0, task(0), false)))), ix_b1 = ix_mem_droppable((st[(ix_first_queue(st, rank, nt, 0, task(0), false)) -> Running]), waiters, ((ix_first_queue(st, rank, nt, 0, task(0), false)))) end)
 + sum x: Task, v: Task . ((st(x) == Done && waiters(x) != [] && v == head(waiters(x)))) -> probe_enabled . Core()
 + sum x: Task . ((st(x) == Done && waiters(x) == [])) -> probe_enabled . Core()
 + sum x: Task . ((st(x) == Queued)) -> probe_enabled . Core()
 + (ix_quiet(nt, st, rank, waiters, ix_telling, ix_droppable)) -> probe_quiet . Core()
 + sum rf_0: Nat . ((ix_quiet(nt, st, rank, waiters, ix_telling, ix_droppable)) && !(((((rf_0) < 4 && nt < cap && made(keyof((rf_0))) == 0))))) -> c_open(rf_0)|probe_refused . delta
 + sum rf_0: Task, rf_1: Task . ((ix_quiet(nt, st, rank, waiters, ix_telling, ix_droppable)) && !((((st((rf_0)) == Running && (rf_0) != (rf_1) && tx((rf_1)) < nt && st((rf_1)) != Free))))) -> c_need(rf_0, rf_1)|probe_refused . delta
 + sum rf_0: Task . ((ix_quiet(nt, st, rank, waiters, ix_telling, ix_droppable)) && !((((st((rf_0)) == Running))))) -> c_finish(rf_0)|probe_refused . delta
 + sum rf_0: Task, rf_1: Task . ((ix_quiet(nt, st, rank, waiters, ix_telling, ix_droppable)) && !((((st((rf_0)) == Running && st((rf_1)) == Running && tx((rf_0)) < tx((rf_1))))))) -> c_finish2(rf_0, rf_1)|probe_refused . delta

%@observers
  + delta;
