% env.mcrl2 -- the environment of the tasks (never generated): the client, who opens
% the instance's tasks in order, and the tasks themselves, which finish, alone or two
% at once, or need another live task. Everything an instance fixes is a map I_*
% defined in instances/<name>.mcrl2; every map takes the instance (sort Inst, declared
% by the generator in each system).

map I_cap: Inst -> Nat;              % tasks at most
    I_opens: Inst -> Nat;            % tasks the client opens
    I_label: Inst # Nat -> Nat;      % the label of the k-th task opened
    I_needs: Inst -> Nat;            % needs the tasks report, at most

act e_open: Nat;
    e_need, e_finish2, e_tell: Task # Task;
    e_finish, e_start, e_drop: Task;
    open: Nat;
    need, finish2, tell: Task # Task;
    finish, start, drop: Task;

% ins: the instance; k: tasks opened; n: needs reported; run: the running tasks;
% alive: the tasks opened and not dropped
proc Env(ins: Inst, k: Nat, n: Nat, run: FSet(Task), alive: FSet(Task)) =
    (k < I_opens(ins)) -> e_open(I_label(ins, k)) . Env(k = k + 1, alive = alive + {task(k)})
  + sum x: Task . e_start(x) . Env(run = run + {x})
  + sum x, y: Task . (n < I_needs(ins) && x in run && y in alive && x != y) ->
      e_need(x, y) . Env(n = n + 1, run = run - {x})
  + sum x: Task . (x in run) -> e_finish(x) . Env(run = run - {x})
  + sum x, y: Task . (x in run && y in run && tx(x) < tx(y)) -> e_finish2(x, y) . Env(run = run - {x} - {y})
  + sum x, v: Task . e_tell(v, x) . Env()
  + sum x: Task . e_drop(x) . Env(alive = alive - {x});

% Core's initial state for a configuration (the generator appends the refined Core's
% extra parameters to this call).
proc CoreStart(cap: Nat) =
  Core(cap, 0, lambda x: Task . 0, lambda x: Task . Free, lambda x: Task . [], lambda x: Task . [],
       lambda x: Task . 0, lambda q: Key . 0, 0);

% ---- the system: Core and the environment agree on the instance, then run
act c_pick, e_pick, pick: Inst;
proc CoreSel = sum i: Inst . c_pick(i) . CoreStart(I_cap(i));
     EnvSel = sum i: Inst . e_pick(i) . Env(i, 0, 0, {}, {});
     System =
  allow({ pick, open, need, finish, finish2, tell, drop, start
%@obs-allow
        },
  comm({ c_pick | e_pick -> pick,
         c_open | e_open -> open,
         c_need | e_need -> need,
         c_finish | e_finish -> finish,
         c_finish2 | e_finish2 -> finish2,
         c_tell | e_tell -> tell,
         c_drop | e_drop -> drop,
         c_start | e_start -> start },
    CoreSel || EnvSel));
